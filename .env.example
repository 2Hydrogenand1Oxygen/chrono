# ==============================================================================
# Chrono Environment Variables (Example)
#
# Copy this file to .env.local and fill in your Supabase project credentials.
# NEVER commit .env.local to Git.
#
# In Supabase Dashboard -> Project Settings -> API:
# 1. Project URL                    -> VITE_SUPABASE_URL
# 2. Project API Keys -> "anon" key -> VITE_SUPABASE_PUBLISHABLE_KEY
#
# IMPORTANT: Vite only exposes variables prefixed with VITE_ to the browser.
# Never use the service-role key here — only the publishable anon key.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
